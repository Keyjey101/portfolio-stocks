# Ключи API Tradernet (freedom24.com).
# Получить: Настройки профиля -> API -> https://freedom24.com/tradernet-api/auth-api
TRADERNET_PUBLIC_KEY=
TRADERNET_PRIVATE_KEY=

# Если freedom24.com недоступен напрямую — укажи локальный HTTP-прокси
# (например, порт Clash/v2rayN) и раскомментируй:
# TRADERNET_PROXY=http://127.0.0.1:7890

# z.ai GLM — LLM-часть (детектор слома тезиса, реестр фальсификаций, агенты)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

# Монте-Карло (#4): довнесения в месяц, горизонт лет, цель (опционально)
MC_MONTHLY_USD=250
MC_YEARS=10
# MC_TARGET_USD=100000

# ── Вход владельца ──
# Пусто = авторизация выключена, все — владелец (годится только локально!).
# На сервере обязательно задать, например: openssl rand -base64 18
APP_PASSWORD=

# ── Сеть / деплой ──
# наружу смотрит только nginx; приложение слушает локально
HOST=127.0.0.1
# страницы+статика (nginx: location / → 127.0.0.1:3000)
PORT=3000
# API под существующий конфиг nginx (location /api/ → 127.0.0.1:3001);
# не задан — один сервер на PORT (локальная работа)
API_PORT=3001

# Дневной предохранитель бюджета z.ai (считает каждый вызов, включая ретраи)
LLM_DAILY_LIMIT=300

# ── Данные (не обязательно) ──
# фолбэк новостей, если Yahoo RSS молчит: newsapi.org
NEWSAPI_KEY=
# макро-полоса на дашборде (ставки/спред/CPI/безработица): fred.stlouisfed.org
FRED_API_KEY=
# на будущее: котировки через Alpaca (пока не используется)
ALPACA_API_KEY=
ALPACA_API_SECRET=

